{
  "name": "gbf-tracker",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "wrangler dev",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "wrangler types server/worker-configuration.d.ts && tsc && tsc -p src && tsc -p server && tsc -p test",
    "deploy": "npm run typecheck && npm test && wrangler deploy"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "wrangler": "4.153.0"
  },
  "dependencies": {
    "hono": "4.13.13"
  }
}
